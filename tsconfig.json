{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "lib": ["es2022", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["vite/client"]
    },
    "include": ["src", "test", "vendor", "vite.config.ts"]
}
